#
# Themerr environment variables
#
THEMERR_TAG="${THEMERR_TAG:-latest}"
THEMERR_WEBUI_PORT="${THEMERR_WEBUI_PORT:-9494}"                                         # Change only for a host-port conflict
THEMERR_CONNECTOR_PORT="${THEMERR_CONNECTOR_PORT:-9495}"                                 # Change only for a host-port conflict
THEMERR_CONFIG_PATH="${THEMERR_CONFIG_PATH:-./config/themerr}"                           # Edit for your host: existing writable Themerr state
THEMERR_TOKEN_KEY_PATH="${THEMERR_TOKEN_KEY_PATH:-./config/secrets/themerr-tokens.key}"  # Edit for your host: existing private encryption key

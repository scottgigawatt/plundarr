#
# Tracearr database service image and shared-memory variables
#
TRACEARR_DB_TAG="${TRACEARR_DB_TAG:-pg18.4-ts2.29.1}"
TRACEARR_DB_SHM_SIZE="${TRACEARR_DB_SHM_SIZE:-512mb}"

# Tracearr database service environment variables
TRACEARR_DB_USER="${TRACEARR_DB_USER:-tracearr}"
TRACEARR_DB_NAME="${TRACEARR_DB_NAME:-tracearr}"

# Maraudarr generates a URI-safe database password on first generation.
TRACEARR_DB_PASSWORD=""

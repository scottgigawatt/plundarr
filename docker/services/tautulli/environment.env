#
# Tautulli environment variables
#
TAUTULLI_TAG="${TAUTULLI_TAG:-latest}"
TAUTULLI_PUID="${TAUTULLI_PUID:-1029}"  # Edit for your host: run `id -u`
TAUTULLI_PGID="${TAUTULLI_PGID:-100}"   # Edit for your host: run `id -g`
TAUTULLI_WEBUI_PORT="${TAUTULLI_WEBUI_PORT:-8181}"  # Change only for a host-port conflict
TAUTULLI_CONFIG_PATH="${TAUTULLI_CONFIG_PATH:-./config/tautulli}"

#
# Kometa Overlay Reset environment variables
#
OVERLAY_RESET_TAG="${OVERLAY_RESET_TAG:-latest}"
OVERLAY_RESET_CONFIG_PATH="${OVERLAY_RESET_CONFIG_PATH:-./config/overlay-reset}"
OVERLAY_RESET_PLEX_URL="${OVERLAY_RESET_PLEX_URL:-http://host.or.ip:32400}"  # Edit before launch: Plex server URL
OVERLAY_RESET_PLEX_TOKEN="${OVERLAY_RESET_PLEX_TOKEN:-change-me}"            # Edit before launch: Plex authentication token
OVERLAY_RESET_PLEX_LIBRARY="${OVERLAY_RESET_PLEX_LIBRARY:-Movies}"           # Edit before launch: exact Plex library name
OVERLAY_RESET_KOMETA_ASSET="${OVERLAY_RESET_KOMETA_ASSET:-}"
OVERLAY_RESET_KOMETA_ORIGINAL="${OVERLAY_RESET_KOMETA_ORIGINAL:-}"
OVERLAY_RESET_TMDB_API_KEY="${OVERLAY_RESET_TMDB_API_KEY:-}"
OVERLAY_RESET_START="${OVERLAY_RESET_START:-}"
OVERLAY_RESET_ITEMS="${OVERLAY_RESET_ITEMS:-}"
OVERLAY_RESET_LABELS="${OVERLAY_RESET_LABELS:-}"
OVERLAY_RESET_TIMEOUT="${OVERLAY_RESET_TIMEOUT:-600}"
OVERLAY_RESET_NO_VERIFY_SSL="${OVERLAY_RESET_NO_VERIFY_SSL:-False}"
OVERLAY_RESET_DRY_RUN="${OVERLAY_RESET_DRY_RUN:-True}"
OVERLAY_RESET_KOMETA_FLAT="${OVERLAY_RESET_KOMETA_FLAT:-False}"
OVERLAY_RESET_NO_MAIN="${OVERLAY_RESET_NO_MAIN:-False}"
OVERLAY_RESET_SEASON="${OVERLAY_RESET_SEASON:-True}"
OVERLAY_RESET_EPISODE="${OVERLAY_RESET_EPISODE:-True}"
OVERLAY_RESET_IGNORE_RESUME="${OVERLAY_RESET_IGNORE_RESUME:-False}"
OVERLAY_RESET_TRACE="${OVERLAY_RESET_TRACE:-False}"
OVERLAY_RESET_LOG_REQUESTS="${OVERLAY_RESET_LOG_REQUESTS:-False}"

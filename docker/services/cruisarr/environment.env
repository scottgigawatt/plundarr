#
# Cruisarr environment variables
#
CRUISARR_IMAGE="${CRUISARR_IMAGE:-ghcr.io/scottgigawatt/cruisarr}"
CRUISARR_TAG="${CRUISARR_TAG:-latest}"
CRUISARR_WEBUI_PORT="${CRUISARR_WEBUI_PORT:-6699}"                 # Change only for a host-port conflict
CRUISARR_CONFIG_PATH="${CRUISARR_CONFIG_PATH:-./config/cruisarr}"  # Edit for your host: persistent application data
CRUISARR_SECRET_KEY="${CRUISARR_SECRET_KEY:-}"
CRUISARR_SETUP_SECRET="${CRUISARR_SETUP_SECRET:-}"
CRUISARR_ORIGIN="${CRUISARR_ORIGIN:-}"                             # Edit for your host: browser origin when using a reverse proxy
CRUISARR_ALLOW_HTTP="${CRUISARR_ALLOW_HTTP:-1}"
CRUISARR_WHISPARR_LIBRARY_LIMIT_MIB="${CRUISARR_WHISPARR_LIBRARY_LIMIT_MIB:-64}"
CRUISARR_UPDATE_CHECK="${CRUISARR_UPDATE_CHECK:-0}"
CRUISARR_DISCORD_WEBHOOK_URL="${CRUISARR_DISCORD_WEBHOOK_URL:-}"   # Edit before launch: optional private HTTPS webhook
CRUISARR_DISCORD_DETAIL="${CRUISARR_DISCORD_DETAIL:-0}"

#
# Jellyfin Vue environment variables
#
JELLYFIN_VUE_TAG="${JELLYFIN_VUE_TAG:-unstable}"
JELLYFIN_VUE_WEBUI_PORT="${JELLYFIN_VUE_WEBUI_PORT:-8082}"                                              # Change only for a host-port conflict
JELLYFIN_VUE_DEFAULT_SERVERS="${JELLYFIN_VUE_DEFAULT_SERVERS:-}"                                        # Edit for your host: Jellyfin URLs reachable from client devices
JELLYFIN_VUE_DISABLE_SERVER_SELECTION="${JELLYFIN_VUE_DISABLE_SERVER_SELECTION:-0}"
JELLYFIN_VUE_HISTORY_ROUTER_MODE="${JELLYFIN_VUE_HISTORY_ROUTER_MODE:-1}"
JELLYFIN_VUE_NGINX_CONFIG_PATH="${JELLYFIN_VUE_NGINX_CONFIG_PATH:-./config/jellyfin-vue/default.conf}"  # Edit for your host: Vue nginx configuration file

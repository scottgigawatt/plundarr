#
# environment.env: Defaults for the selectable Stash service.
#

#
# Stash environment variables
#
STASH_TAG="${STASH_TAG:-latest}"
STASH_WEBUI_PORT="${STASH_WEBUI_PORT:-9999}"                                     # Change only for a host-port conflict
STASH_CONFIG_PATH="${STASH_CONFIG_PATH:-./config/stash/config}"
STASH_METADATA_PATH="${STASH_METADATA_PATH:-./config/stash/metadata}"
STASH_CACHE_PATH="${STASH_CACHE_PATH:-./config/stash/cache}"
STASH_BLOBS_PATH="${STASH_BLOBS_PATH:-./config/stash/blobs}"
STASH_GENERATED_PATH="${STASH_GENERATED_PATH:-./config/stash/generated}"
STASH_DATA_PATH="${STASH_DATA_PATH:-/volume1/jellyfin}"                          # Edit for your host: same media root as Jellyfin
STASH_CREATORS_PATH="${STASH_CREATORS_PATH:-/volume1/jellyfin/scenes/creators}"  # Edit for your host: existing creators directory

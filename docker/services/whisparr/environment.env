#
# Whisparr environment variables
#
WHISPARR_TAG="${WHISPARR_TAG:-v3}"
WHISPARR_WEBUI_PORT="${WHISPARR_WEBUI_PORT:-6969}"      # Change only for a host-port conflict
WHISPARR_CONFIG_PATH="${WHISPARR_CONFIG_PATH:-./config/whisparr}"
WHISPARR_DATA_PATH="${WHISPARR_DATA_PATH:-/volume1/media/adult}"  # Edit for your host: shared movies and scenes root

# Whisparr library and import paths
WHISPARR_MOVIES_PATH="${WHISPARR_MOVIES_PATH:-/volume1/media/adult/movies}"     # Edit for your host: managed movies
WHISPARR_SCENES_PATH="${WHISPARR_SCENES_PATH:-/volume1/media/adult/scenes}"     # Edit for your host: managed scenes
WHISPARR_IMPORT_PATH="${WHISPARR_IMPORT_PATH:-/volume1/media/adult/import}"     # Edit for your host: shared import staging
WHISPARR_RECYCLE_PATH="${WHISPARR_RECYCLE_PATH:-/volume1/media/adult/recycle}"  # Edit for your host: private recycling bin

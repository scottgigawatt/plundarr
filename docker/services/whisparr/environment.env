#
# Whisparr environment variables
#
WHISPARR_TAG="${WHISPARR_TAG:-v3}"
WHISPARR_WEBUI_PORT="${WHISPARR_WEBUI_PORT:-6969}"                                   # Change only for a host-port conflict
WHISPARR_CONFIG_PATH="${WHISPARR_CONFIG_PATH:-./config/whisparr}"
WHISPARR_DATA_PATH="${WHISPARR_DATA_PATH:-/volume1/media/adult}"                     # Unused legacy path for shared movies and scenes root
WHISPARR_IMPORT_PATH="${WHISPARR_IMPORT_PATH:-/volume1/media/adult/import}"          # Edit for your host: shared import staging
WHISPARR_MOVIES_PATH="${WHISPARR_MOVIES_PATH:-/volume1/media/adult/movies/main}"     # Edit for your host: managed movies
WHISPARR_SCENES_PATH="${WHISPARR_SCENES_PATH:-/volume1/media/adult/scenes/main}"     # Edit for your host: managed scenes
WHISPARR_RECYCLE_PATH="${WHISPARR_RECYCLE_PATH:-/volume1/media/adult/recycle/main}"  # Edit for your host: private recycling bin

#
# Whisparr Alt environment variables
#
WHISPARR_ALT_TAG="${WHISPARR_ALT_TAG:-v3}"
WHISPARR_ALT_WEBUI_PORT="${WHISPARR_ALT_WEBUI_PORT:-6970}"                                  # Change only for a host-port conflict
WHISPARR_ALT_CONFIG_PATH="${WHISPARR_ALT_CONFIG_PATH:-./config/whisparr-alt}"
WHISPARR_ALT_DATA_PATH="${WHISPARR_ALT_DATA_PATH:-/volume1/media/adult}"                    # Unused legacy path for shared movies and scenes root
WHISPARR_ALT_IMPORT_PATH="${WHISPARR_ALT_IMPORT_PATH:-/volume1/media/adult/import}"         # Edit for your host: shared import staging
WHISPARR_ALT_MOVIES_PATH="${WHISPARR_ALT_MOVIES_PATH:-/volume1/media/adult/movies/alt}"    # Edit for your host: managed movies
WHISPARR_ALT_SCENES_PATH="${WHISPARR_ALT_SCENES_PATH:-/volume1/media/adult/scenes/alt}"     # Edit for your host: managed scenes
WHISPARR_ALT_RECYCLE_PATH="${WHISPARR_ALT_RECYCLE_PATH:-/volume1/media/adult/recycle/alt}"  # Edit for your host: private recycling bin

#
# environment.env: PATTRMM Neo image, schedule, identity, and storage defaults.
#
PATTRMM_TAG="${PATTRMM_TAG:-neo}"

PATTRMM_TIMES="${PATTRMM_TIMES:-02:00,14:00}"         # Run before Kometa's 05:00 and 17:00 schedule
PATTRMM_SETTINGS="${PATTRMM_SETTINGS:-settings.yml}"  # Comma-separated filenames under /settings

PATTRMM_PUID="${PATTRMM_PUID:-1000}"  # Edit for your host: run `id -u`
PATTRMM_PGID="${PATTRMM_PGID:-1000}"  # Edit for your host: run `id -g`

PATTRMM_CONFIG_PATH="${PATTRMM_CONFIG_PATH:-./config/pattrmm}"
PATTRMM_SETTINGS_PATH="${PATTRMM_SETTINGS_PATH:-${KOMETA_CONFIG_PATH}/pattrmm}"  # Authored Neo settings directory

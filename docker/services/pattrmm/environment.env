#
# PATTRMM environment variables
#
PATTRMM_TAG="${PATTRMM_TAG:-latest}"
PATTRMM_TIME="${PATTRMM_TIME:-02:00}"
PATTRMM_PUID="${PATTRMM_PUID:-1000}"  # Edit for your host: run `id -u`
PATTRMM_PGID="${PATTRMM_PGID:-1000}"  # Edit for your host: run `id -g`
PATTRMM_CONFIG_PATH="${PATTRMM_CONFIG_PATH:-./config/pattrmm}"

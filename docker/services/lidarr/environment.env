#
# Lidarr environment variables
#
LIDARR_TAG="${LIDARR_TAG:-latest}"
LIDARR_WEBUI_PORT="${LIDARR_WEBUI_PORT:-8686}"  # Change only for a host-port conflict
LIDARR_CONFIG_PATH="${LIDARR_CONFIG_PATH:-./config/lidarr}"
HOST_MUSIC_PATH="${HOST_MUSIC_PATH:-/volume1/plex/music}"  # Edit for your host: music library

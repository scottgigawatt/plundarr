#
# Recyclarr environment variables
#
RECYCLARR_TAG="${RECYCLARR_TAG:-8}"
RECYCLARR_CONFIG_PATH="${RECYCLARR_CONFIG_PATH:-./config/recyclarr}"
RECYCLARR_RADARR_URL="${RECYCLARR_RADARR_URL:-http://radarr:7878}"                 # Edit when Radarr is outside this stack
RECYCLARR_RADARR_API_KEY="${RECYCLARR_RADARR_API_KEY:-change-me}"                 # Edit before sync: Radarr API key
RECYCLARR_SONARR_URL="${RECYCLARR_SONARR_URL:-http://sonarr:8989}"                 # Edit when Sonarr is outside this stack
RECYCLARR_SONARR_API_KEY="${RECYCLARR_SONARR_API_KEY:-change-me}"                 # Edit before sync: Sonarr API key

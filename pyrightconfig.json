// pyrightconfig.json: Shared strict Python checks for editors, tests, and CI.
//

{
    "include": [
        "docker/src",
        "docker/tests",
        "test/typing"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*"
    ],
    "typeCheckingMode": "strict",
    "reportUnnecessaryTypeIgnoreComment": "error",
    "pythonVersion": "3.14",
    "pythonPlatform": "Linux",
    "extraPaths": [
        "docker/src"
    ],
    "stubPath": "test/typing"
}

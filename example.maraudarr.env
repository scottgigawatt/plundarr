#
# example.maraudarr.env: Build and runtime defaults for the Maraudarr image.
#

#
# Maraudarr image reference, tag metadata, and configurable install location.
#
MARAUDARR_IMAGE="${MARAUDARR_IMAGE:-ghcr.io/scottgigawatt/maraudarr:latest}"
MARAUDARR_TAG="${MARAUDARR_TAG:-latest}"
MARAUDARR_BIN_HOME="${MARAUDARR_BIN_HOME:-/maraudarr}"

#
# Default unprivileged identity used inside locally built images.
#
MARAUDARR_UID="${MARAUDARR_UID:-1000}"
MARAUDARR_GID="${MARAUDARR_GID:-1000}"
MARAUDARR_GROUP="${MARAUDARR_GROUP:-maraudarr}"

#
# Pinned build images, Compose source and network-module floor, plus OCI metadata.
#
ALPINE_TAG="${ALPINE_TAG:-3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a}"
GO_TAG="${GO_TAG:-1.26.10-alpine3.24@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba}"
DOCKER_COMPOSE_VERSION="${DOCKER_COMPOSE_VERSION:-v5.6.1}"
GO_X_NET_VERSION="${GO_X_NET_VERSION:-v0.60.0}"
IMAGE_CREATED="${IMAGE_CREATED:-unknown}"
IMAGE_REVISION="${IMAGE_REVISION:-unknown}"

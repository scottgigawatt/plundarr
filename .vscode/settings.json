    //
    // Keep Makefile Tools from inventing a configure step for this project.
    //
    "makefile.configureOnOpen": false,

    //
    // Associate special repository files with their correct language modes.
    //
    "files.associations": {
        ".secrets.baseline": "jsonc",
        "**/CODEOWNERS": "plaintext",
        "Dockerfile*": "dockerfile"
    },

    //
    // Mirror EditorConfig indentation while disabling VS Code auto-detection.
    //
    "[dockerfile]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[css][javascript]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[github-actions-workflow]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[json][jsonc]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[makefile]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[markdown]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[shellscript]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },

    //
    // Keep TOML formatting at two spaces and validate Python package metadata
    // against SchemaStore through Even Better TOML.
    //
    "evenBetterToml.formatter.indentString": "  ",
    "evenBetterToml.schema.associations": {
        "(^|/)docker/pyproject\\.toml$": "https://json.schemastore.org/pyproject.json"
    },

    //
    // Enable shell diagnostics for every project-owned helper.
    //
    "shellcheck.enable": true,

    //
    // Teach the YAML extension about MkDocs' Python tag and repository schemas.
    //
    "yaml.customTags": [
        "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format"
    ],
    "yaml.format.enable": true,
    "yaml.schemaStore.enable": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            "**/.github/workflows/*.yml",
            "**/.github/workflows/*.yaml"
        ],
        "https://raw.githubusercontent.com/compose-spec/compose-spec/main/schema/compose-spec.json": [
            "**/docker-compose*.yml",
            "**/docker-compose*.yaml",
            "docker/templates/compose.yml"
        ],
        "https://json.schemastore.org/pre-commit-config.json": ".pre-commit-config.yaml"
    },
    "yaml.validate": true,
    "yaml.yamlVersion": "1.2"
}

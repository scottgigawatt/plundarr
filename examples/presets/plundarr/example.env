#
# .env file: Environment variables for a generated Plundarr configuration.
#

#
# Name of the project which adds a namespace for all services and networks.
#
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-plundarr}"

#
# Docker network settings for the project.
#
COMPOSE_NETWORK_SUBNET="${COMPOSE_NETWORK_SUBNET:-172.20.0.0/16}"
COMPOSE_NETWORK_IP_RANGE="${COMPOSE_NETWORK_IP_RANGE:-172.20.5.0/24}"
COMPOSE_NETWORK_GATEWAY="${COMPOSE_NETWORK_GATEWAY:-172.20.5.254}"

#
# Host paths to downloads and media folders.
#
HOST_DOWNLOADS_PATH="${HOST_DOWNLOADS_PATH:-/volume1/downloads}"                             # Edit for your host: shared download root
HOST_TORRENTS_DOWNLOADS_PATH="${HOST_TORRENTS_DOWNLOADS_PATH:-/volume1/downloads/torrents}"  # Edit for your host: torrent downloads
HOST_USENET_DOWNLOADS_PATH="${HOST_USENET_DOWNLOADS_PATH:-/volume1/downloads/usenet}"        # Edit for your host: Usenet downloads
HOST_MOVIES_PATH="${HOST_MOVIES_PATH:-/volume1/plex/movies}"                                 # Edit for your host: movie library
HOST_TV_PATH="${HOST_TV_PATH:-/volume1/plex/tv}"                                             # Edit for your host: television library
HOST_ANIME_TV_PATH="${HOST_ANIME_TV_PATH:-/volume1/plex/anime-tv}"                           # Edit for your host: anime library
HOST_SCENES_PATH="${HOST_SCENES_PATH:-/volume1/plex/scenes}"                                 # Edit for your host: Boudoirr scenes library

#
# Default container settings.
#
DEFAULT_PUID="${DEFAULT_PUID:-1000}"  # Edit for your host: run `id -u`
DEFAULT_PGID="${DEFAULT_PGID:-1000}"  # Edit for your host: run `id -g`
DEFAULT_GROUP="${DEFAULT_GROUP:-109}"
DEFAULT_UMASK="${DEFAULT_UMASK:-022}"

#
# Standard healthcheck timing settings.
#
DEFAULT_HEALTHCHECK_INTERVAL="${DEFAULT_HEALTHCHECK_INTERVAL:-10s}"
DEFAULT_HEALTHCHECK_TIMEOUT="${DEFAULT_HEALTHCHECK_TIMEOUT:-10s}"
DEFAULT_HEALTHCHECK_START_PERIOD="${DEFAULT_HEALTHCHECK_START_PERIOD:-10s}"
DEFAULT_HEALTHCHECK_RETRIES="${DEFAULT_HEALTHCHECK_RETRIES:-5}"

#
# Container logging settings.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# Timezone for containers.
#
TZ="${TZ:-America/New_York}"  # Edit for your host: IANA timezone, for example America/New_York

#
# Privateerr environment variables
#
PRIVATEERR_TAG="${PRIVATEERR_TAG:-latest}"
PRIVATEERR_CONFIG_PATH="${PRIVATEERR_CONFIG_PATH:-./config/privateerr}"
PRIVATEERR_GLUETUN_CONFIG_PATH="${PRIVATEERR_GLUETUN_CONFIG_PATH:-./config/gluetun}"
PRIVATEERR_IPV6_DISABLED="${PRIVATEERR_IPV6_DISABLED:-1}"

# Privateerr service PIA manual connection environment variables
PIA_VPN_PROTOCOL="${PIA_VPN_PROTOCOL:-wireguard}"
PIA_DISABLE_IPV6="${PIA_DISABLE_IPV6:-yes}"
PIA_DIP_TOKEN="${PIA_DIP_TOKEN:-no}"
PIA_AUTOCONNECT="${PIA_AUTOCONNECT:-true}"
PIA_PREFERRED_REGION="${PIA_PREFERRED_REGION:-ca}"
PIA_CONF_PATH="${PIA_CONF_PATH:-/gluetun/wireguard/wg0.conf}"
PIA_CONNECT="${PIA_CONNECT:-false}"
PIA_PF="${PIA_PF:-true}"
PIA_DNS="${PIA_DNS:-true}"
PIA_WG_SERVER_NAME="${PIA_WG_SERVER_NAME:-}"
PIA_USER="${PIA_USER:-p1234567}"  # Edit before launch: PIA account username
PIA_PASS="${PIA_PASS:-abc123}"    # Edit before launch: PIA account password

# Privateerr service Privateerr environment variables
PRIVATEERR_METADATA_PATH="${PRIVATEERR_METADATA_PATH:-/gluetun/wireguard/privateerr.env}"
PRIVATEERR_HEALTHCHECK_MARKER="${PRIVATEERR_HEALTHCHECK_MARKER:-/healthcheck/privateerr.ready}"
PRIVATEERR_KEEPALIVE="${PRIVATEERR_KEEPALIVE:-true}"
PRIVATEERR_LOG_PATH="${PRIVATEERR_LOG_PATH:-/privateerr-config/logs/privateerr.log}"

# Automatic Gluetun recovery; Maraudarr enables it when both VPN services are selected.
PRIVATEERR_AUTO_RECOVER="${PRIVATEERR_AUTO_RECOVER:-true}"
PRIVATEERR_GLUETUN_API_KEY="${PRIVATEERR_GLUETUN_API_KEY:-}"
PRIVATEERR_GLUETUN_URL="${PRIVATEERR_GLUETUN_URL:-http://gluetun:8000}"
PRIVATEERR_GLUETUN_HEALTH_URL="${PRIVATEERR_GLUETUN_HEALTH_URL:-http://gluetun:9999}"
PRIVATEERR_RECOVERY_INTERVAL_SECONDS="${PRIVATEERR_RECOVERY_INTERVAL_SECONDS:-30}"
PRIVATEERR_RECOVERY_FAILURE_SECONDS="${PRIVATEERR_RECOVERY_FAILURE_SECONDS:-120}"
PRIVATEERR_RECOVERY_COOLDOWN_SECONDS="${PRIVATEERR_RECOVERY_COOLDOWN_SECONDS:-300}"
PRIVATEERR_GENERATION_TIMEOUT_SECONDS="${PRIVATEERR_GENERATION_TIMEOUT_SECONDS:-180}"

#
# Gluetun service image, wrapper, volume, and environment variables
#
GLUETUN_TAG="${GLUETUN_TAG:-latest}"
GLUETUN_CONFIG_PATH="${GLUETUN_CONFIG_PATH:-./config/gluetun}"
GLUETUN_ENTRYPOINT_WRAPPER="${GLUETUN_ENTRYPOINT_WRAPPER:-/gluetun/scripts/gluetun-entrypoint-wrapper.sh}"
GLUETUN_QBITTORRENT_PORT_FORWARDING_SCRIPT="${GLUETUN_QBITTORRENT_PORT_FORWARDING_SCRIPT:-/gluetun/scripts/qbittorrent-port-forwarding.sh}"
GLUETUN_VPN_SERVICE_PROVIDER="${GLUETUN_VPN_SERVICE_PROVIDER:-custom}"
GLUETUN_VPN_TYPE="${GLUETUN_VPN_TYPE:-wireguard}"
GLUETUN_VPN_PORT_FORWARDING="${GLUETUN_VPN_PORT_FORWARDING:-on}"
GLUETUN_VPN_PORT_FORWARDING_PROVIDER="${GLUETUN_VPN_PORT_FORWARDING_PROVIDER:-private internet access}"
GLUETUN_HEALTH_TARGET_ADDRESSES="${GLUETUN_HEALTH_TARGET_ADDRESSES:-cloudflare.com:443,github.com:443}"
GLUETUN_HEALTH_ICMP_TARGET_IPS="${GLUETUN_HEALTH_ICMP_TARGET_IPS:-1.1.1.1,8.8.8.8}"
GLUETUN_HEALTH_SERVER_ADDRESS="${GLUETUN_HEALTH_SERVER_ADDRESS:-127.0.0.1:9999}"
GLUETUN_HEALTH_RESTART_VPN="${GLUETUN_HEALTH_RESTART_VPN:-on}"
GLUETUN_DEFAULT_ENTRYPOINT="${GLUETUN_DEFAULT_ENTRYPOINT:-/gluetun-entrypoint}"
PRIVATEERR_GLUETUN_METADATA_WAIT_SECONDS="${PRIVATEERR_GLUETUN_METADATA_WAIT_SECONDS:-120}"

#
# FlareSolverr environment variables
#
FLARESOLVERR_TAG="${FLARESOLVERR_TAG:-latest}"
FLARESOLVERR_LOG_LEVEL="${FLARESOLVERR_LOG_LEVEL:-info}"
FLARESOLVERR_LOG_HTML="${FLARESOLVERR_LOG_HTML:-false}"
FLARESOLVERR_CAPTCHA_SOLVER="${FLARESOLVERR_CAPTCHA_SOLVER:-none}"
FLARESOLVERR_PORT="${FLARESOLVERR_PORT:-8191}"

#
# Prowlarr environment variables
#
PROWLARR_TAG="${PROWLARR_TAG:-latest}"
PROWLARR_WEBUI_PORT="${PROWLARR_WEBUI_PORT:-9696}"  # Change only for a host-port conflict
PROWLARR_CONFIG_PATH="${PROWLARR_CONFIG_PATH:-./config/prowlarr}"

#
# qBittorrent environment variables
#
QBITTORRENT_TAG="${QBITTORRENT_TAG:-latest}"
QBITTORRENT_WEBUI_PORT="${QBITTORRENT_WEBUI_PORT:-8080}"  # Change only for a host-port conflict
QBITTORRENT_CONFIG_PATH="${QBITTORRENT_CONFIG_PATH:-./config/qbittorrent}"
QBITTORRENT_PORT_SYNC="${QBITTORRENT_PORT_SYNC:-true}"
QBITTORRENT_API_URL="${QBITTORRENT_API_URL:-http://127.0.0.1:${QBITTORRENT_WEBUI_PORT}}"
QBITTORRENT_API_WAIT_SECONDS="${QBITTORRENT_API_WAIT_SECONDS:-300}"

#
# Radarr environment variables
#
RADARR_TAG="${RADARR_TAG:-latest}"
RADARR_WEBUI_PORT="${RADARR_WEBUI_PORT:-7878}"  # Change only for a host-port conflict
RADARR_CONFIG_PATH="${RADARR_CONFIG_PATH:-./config/radarr}"

#
# Sonarr environment variables
#
SONARR_TAG="${SONARR_TAG:-latest}"
SONARR_WEBUI_PORT="${SONARR_WEBUI_PORT:-8989}"  # Change only for a host-port conflict
SONARR_CONFIG_PATH="${SONARR_CONFIG_PATH:-./config/sonarr}"

#
# Bazarr environment variables
#
BAZARR_TAG="${BAZARR_TAG:-latest}"
BAZARR_WEBUI_PORT="${BAZARR_WEBUI_PORT:-6767}"  # Change only for a host-port conflict
BAZARR_CONFIG_PATH="${BAZARR_CONFIG_PATH:-./config/bazarr}"

#
# Seerr environment variables
#
SEERR_TAG="${SEERR_TAG:-latest}"
SEERR_LOG_LEVEL="${SEERR_LOG_LEVEL:-info}"
SEERR_WEBUI_PORT="${SEERR_WEBUI_PORT:-5055}"  # Change only for a host-port conflict
SEERR_CONFIG_PATH="${SEERR_CONFIG_PATH:-./config/seerr}"

#
# Calibre-Web Automated environment variables
#
CWA_TAG="${CWA_TAG:-latest}"
CWA_WEBUI_PORT="${CWA_WEBUI_PORT:-8213}"                        # Change only for a host-port conflict
CWA_CONFIG_PATH="${CWA_CONFIG_PATH:-./config/calibre-web-automated/config}"
CWA_INGEST_PATH="${CWA_INGEST_PATH:-./config/calibre-web-automated/ingest}"
CWA_LIBRARY_PATH="${CWA_LIBRARY_PATH:-/volume1/books/calibre}"  # Edit for your host: Calibre library containing metadata.db
CWA_NETWORK_SHARE_MODE="${CWA_NETWORK_SHARE_MODE:-false}"       # Set true only when config or library storage uses NFS or SMB

#
# Cleanuparr environment variables
#
CLEANUPARR_TAG="${CLEANUPARR_TAG:-latest}"
CLEANUPARR_WEBUI_PORT="${CLEANUPARR_WEBUI_PORT:-11011}"  # Change only for a host-port conflict
CLEANUPARR_CONFIG_PATH="${CLEANUPARR_CONFIG_PATH:-./config/cleanuparr}"
CLEANUPARR_BASE_PATH="${CLEANUPARR_BASE_PATH:-}"

#
# Speedtest Tracker environment variables
#
SPEEDTEST_TRACKER_TAG="${SPEEDTEST_TRACKER_TAG:-latest}"
SPEEDTEST_TRACKER_WEBUI_PORT="${SPEEDTEST_TRACKER_WEBUI_PORT:-9080}"  # Change only for a host-port conflict
SPEEDTEST_TRACKER_CONFIG_PATH="${SPEEDTEST_TRACKER_CONFIG_PATH:-./config/speedtest-tracker}"
SPEEDTEST_TRACKER_DB_CONNECTION="${SPEEDTEST_TRACKER_DB_CONNECTION:-sqlite}"
SPEEDTEST_TRACKER_APP_KEY="${SPEEDTEST_TRACKER_APP_KEY:-abc123}"
SPEEDTEST_TRACKER_SCHEDULE="${SPEEDTEST_TRACKER_SCHEDULE:-0 */6 * * *}"
SPEEDTEST_TRACKER_SERVERS="${SPEEDTEST_TRACKER_SERVERS:-server1,server2,server3}"
SPEEDTEST_TRACKER_PRUNE="${SPEEDTEST_TRACKER_PRUNE:-0}"

#
# Apprise notification environment variables
#
APPRISE_TAG="${APPRISE_TAG:-latest}"
APPRISE_API_ONLY="${APPRISE_API_ONLY:-yes}"
APPRISE_STATEFUL_MODE="${APPRISE_STATEFUL_MODE:-disabled}"
APPRISE_WORKER_COUNT="${APPRISE_WORKER_COUNT:-1}"
APPRISE_ATTACH_SIZE="${APPRISE_ATTACH_SIZE:-0}"

#
# Tracearr database service image and resource variables
#
TRACEARR_DB_TAG="${TRACEARR_DB_TAG:-pg18}"
TRACEARR_DB_SHM_SIZE="${TRACEARR_DB_SHM_SIZE:-512mb}"
TRACEARR_DB_NOFILE_SOFT="${TRACEARR_DB_NOFILE_SOFT:-65536}"
TRACEARR_DB_NOFILE_HARD="${TRACEARR_DB_NOFILE_HARD:-65536}"

# Tracearr database service environment variables
TRACEARR_DB_USER="${TRACEARR_DB_USER:-tracearr}"
TRACEARR_DB_NAME="${TRACEARR_DB_NAME:-tracearr}"

# Maraudarr generates a URI-safe database password on first generation.
TRACEARR_DB_PASSWORD=""

#
# Tracearr Redis service image variables
#
TRACEARR_REDIS_TAG="${TRACEARR_REDIS_TAG:-8-alpine}"

#
# Tracearr service image and published-port variables
#
TRACEARR_TAG="${TRACEARR_TAG:-latest}"
TRACEARR_WEBUI_PORT="${TRACEARR_WEBUI_PORT:-3080}"  # Change only for a host-port conflict

# Tracearr service application environment variables
TRACEARR_NODE_ENV="${TRACEARR_NODE_ENV:-production}"
TRACEARR_HOST="${TRACEARR_HOST:-0.0.0.0}"
TRACEARR_PORT="${TRACEARR_PORT:-3000}"
TRACEARR_DATABASE_URL="${TRACEARR_DATABASE_URL:-postgres://${TRACEARR_DB_USER}:${TRACEARR_DB_PASSWORD}@tracearr-db:5432/${TRACEARR_DB_NAME}}"
TRACEARR_REDIS_URL="${TRACEARR_REDIS_URL:-redis://tracearr-redis:6379}"

# Maraudarr generates separate authentication keys on first generation.
TRACEARR_JWT_SECRET=""
TRACEARR_COOKIE_SECRET=""
TRACEARR_AUTH_SECRET=""

# Tracearr service logging and reverse-proxy variables
TRACEARR_LOG_LEVEL="${TRACEARR_LOG_LEVEL:-info}"
TRACEARR_TRUST_PROXY="${TRACEARR_TRUST_PROXY:-false}"

#
# Duplicati environment variables
#
DUPLICATI_TAG="${DUPLICATI_TAG:-latest}"
DUPLICATI_WEBUI_PORT="${DUPLICATI_WEBUI_PORT:-8200}"  # Change only for a host-port conflict
DUPLICATI_CONFIG_PATH="${DUPLICATI_CONFIG_PATH:-./config/duplicati}"
DUPLICATI_BACKUPS_PATH="${DUPLICATI_BACKUPS_PATH:-/volume1/NetBackup/duplicati}"
DUPLICATI_SOURCE_PATH="${DUPLICATI_SOURCE_PATH:-./config}"
DUPLICATI_SETTINGS_ENCRYPTION_KEY="${DUPLICATI_SETTINGS_ENCRYPTION_KEY:-change-me-duplicati-settings-key}"
DUPLICATI_WEBSERVICE_PASSWORD="${DUPLICATI_WEBSERVICE_PASSWORD:-changeme}"

#
# Homepage environment variables
#
HOMEPAGE_TAG="${HOMEPAGE_TAG:-latest}"
HOMEPAGE_LOG_LEVEL="${HOMEPAGE_LOG_LEVEL:-debug}"
HOMEPAGE_ALLOWED_HOSTS="${HOMEPAGE_ALLOWED_HOSTS:-host.or.ip:3000}"
HOMEPAGE_WEBUI_PORT="${HOMEPAGE_WEBUI_PORT:-3000}"  # Change only for a host-port conflict
HOMEPAGE_CONFIG_PATH="${HOMEPAGE_CONFIG_PATH:-./config/homepage}"
HOMEPAGE_IMAGES_PATH="${HOMEPAGE_IMAGES_PATH:-./config/homepage/images}"
HOMEPAGE_DATA_ROOT_PATH="${HOMEPAGE_DATA_ROOT_PATH:-/volume1/plex}"

# Homepage native password authentication variables
HOMEPAGE_AUTH_ENABLED="${HOMEPAGE_AUTH_ENABLED:-true}"
HOMEPAGE_AUTH_SECRET="${HOMEPAGE_AUTH_SECRET:-}"
HOMEPAGE_AUTH_PASSWORD="${HOMEPAGE_AUTH_PASSWORD:-}"
HOMEPAGE_EXTERNAL_URL="${HOMEPAGE_EXTERNAL_URL:-http://host.or.ip:${HOMEPAGE_WEBUI_PORT}}"

# Homepage title, search, and weather display variables
HOMEPAGE_VAR_TITLE="${HOMEPAGE_VAR_TITLE:-Plundarr}"
HOMEPAGE_VAR_SEARCH_PROVIDER="${HOMEPAGE_VAR_SEARCH_PROVIDER:-google}"
HOMEPAGE_VAR_WEATHER_CITY="${HOMEPAGE_VAR_WEATHER_CITY:-New York}"
HOMEPAGE_VAR_WEATHER_LAT="${HOMEPAGE_VAR_WEATHER_LAT:-40.7128}"
HOMEPAGE_VAR_WEATHER_LONG="${HOMEPAGE_VAR_WEATHER_LONG:-74.0060}"
HOMEPAGE_VAR_WEATHER_TZ="${HOMEPAGE_VAR_WEATHER_TZ:-America/New_York}"
HOMEPAGE_VAR_WEATHER_UNIT="${HOMEPAGE_VAR_WEATHER_UNIT:-metric}"

# Homepage bookmark click-target variables
HOMEPAGE_VAR_DSM_HREF="${HOMEPAGE_VAR_DSM_HREF:-http://host.or.ip}"
HOMEPAGE_VAR_DSM2_HREF="${HOMEPAGE_VAR_DSM2_HREF:-http://host.or.ip}"
HOMEPAGE_VAR_WIKI_HREF="${HOMEPAGE_VAR_WIKI_HREF:-http://host.or.ip}"

# Homepage Plex click-target and widget variables
PLEX_WEBUI_PORT="${PLEX_WEBUI_PORT:-32400}"
HOMEPAGE_VAR_PLEX_HREF="${HOMEPAGE_VAR_PLEX_HREF:-http://host.or.ip:32400}"
HOMEPAGE_VAR_PLEX_URL="${HOMEPAGE_VAR_PLEX_URL:-http://host.or.ip}"
HOMEPAGE_VAR_PLEX_TOKEN="${HOMEPAGE_VAR_PLEX_TOKEN:-abc123}"

# Homepage Tracearr click-target and widget variables
HOMEPAGE_VAR_TRACEARR_HREF="${HOMEPAGE_VAR_TRACEARR_HREF:-http://host.or.ip:3080}"
HOMEPAGE_VAR_TRACEARR_URL="${HOMEPAGE_VAR_TRACEARR_URL:-http://tracearr:${TRACEARR_PORT}}"
HOMEPAGE_VAR_TRACEARR_KEY="${HOMEPAGE_VAR_TRACEARR_KEY:-}"

# Homepage Radarr click-target and widget variables
HOMEPAGE_VAR_RADARR_HREF="${HOMEPAGE_VAR_RADARR_HREF:-http://host.or.ip:7878}"
HOMEPAGE_VAR_RADARR_URL="${HOMEPAGE_VAR_RADARR_URL:-http://radarr}"
HOMEPAGE_VAR_RADARR_KEY="${HOMEPAGE_VAR_RADARR_KEY:-abc123}"

# Homepage Sonarr click-target and widget variables
HOMEPAGE_VAR_SONARR_HREF="${HOMEPAGE_VAR_SONARR_HREF:-http://host.or.ip:8989}"
HOMEPAGE_VAR_SONARR_URL="${HOMEPAGE_VAR_SONARR_URL:-http://sonarr}"
HOMEPAGE_VAR_SONARR_KEY="${HOMEPAGE_VAR_SONARR_KEY:-abc123}"

# Homepage Calibre-Web Automated click-target and widget variables
HOMEPAGE_VAR_CWA_HREF="${HOMEPAGE_VAR_CWA_HREF:-http://host.or.ip:8213}"
HOMEPAGE_VAR_CWA_URL="${HOMEPAGE_VAR_CWA_URL:-http://calibre-web-automated:8083}"
HOMEPAGE_VAR_CWA_USER="${HOMEPAGE_VAR_CWA_USER:-username}"
HOMEPAGE_VAR_CWA_PASS="${HOMEPAGE_VAR_CWA_PASS:-abc123}"

# Homepage Bazarr click-target and widget variables
HOMEPAGE_VAR_BAZARR_HREF="${HOMEPAGE_VAR_BAZARR_HREF:-http://host.or.ip:6767}"
HOMEPAGE_VAR_BAZARR_URL="${HOMEPAGE_VAR_BAZARR_URL:-http://bazarr}"
HOMEPAGE_VAR_BAZARR_KEY="${HOMEPAGE_VAR_BAZARR_KEY:-abc123}"

# Homepage Seerr click-target and widget variables
HOMEPAGE_VAR_SEERR_HREF="${HOMEPAGE_VAR_SEERR_HREF:-http://host.or.ip:5055}"
HOMEPAGE_VAR_SEERR_URL="${HOMEPAGE_VAR_SEERR_URL:-http://host.or.ip}"
HOMEPAGE_VAR_SEERR_KEY="${HOMEPAGE_VAR_SEERR_KEY:-abc123}"

# Homepage Prowlarr click-target and widget variables
HOMEPAGE_VAR_PROWLARR_HREF="${HOMEPAGE_VAR_PROWLARR_HREF:-http://host.or.ip:9696}"
HOMEPAGE_VAR_PROWLARR_URL="${HOMEPAGE_VAR_PROWLARR_URL:-http://prowlarr}"
HOMEPAGE_VAR_PROWLARR_KEY="${HOMEPAGE_VAR_PROWLARR_KEY:-abc123}"

# Homepage qBittorrent click-target and widget variables
HOMEPAGE_VAR_QBITTORRENT_HREF="${HOMEPAGE_VAR_QBITTORRENT_HREF:-http://host.or.ip:8080}"
HOMEPAGE_VAR_QBITTORRENT_URL="${HOMEPAGE_VAR_QBITTORRENT_URL:-http://host.or.ip}"
HOMEPAGE_VAR_QBITTORRENT_USER="${HOMEPAGE_VAR_QBITTORRENT_USER:-username}"
HOMEPAGE_VAR_QBITTORRENT_PASS="${HOMEPAGE_VAR_QBITTORRENT_PASS:-abc123}"

# Homepage Speedtest Tracker click-target and widget variables
HOMEPAGE_VAR_SPEEDTEST_HREF="${HOMEPAGE_VAR_SPEEDTEST_HREF:-http://host.or.ip:9080}"
HOMEPAGE_VAR_SPEEDTEST_URL="${HOMEPAGE_VAR_SPEEDTEST_URL:-http://host.or.ip}"

#
# Watchtower environment variables
#
WATCHTOWER_TAG="${WATCHTOWER_TAG:-latest}"
WATCHTOWER_POLL_INTERVAL="${WATCHTOWER_POLL_INTERVAL:-86400}"
WATCHTOWER_CLEANUP="${WATCHTOWER_CLEANUP:-true}"
WATCHTOWER_INCLUDE_STOPPED="${WATCHTOWER_INCLUDE_STOPPED:-true}"
WATCHTOWER_REVIVE_STOPPED="${WATCHTOWER_REVIVE_STOPPED:-false}"
WATCHTOWER_NOTIFICATIONS="${WATCHTOWER_NOTIFICATIONS:-shoutrrr}"
WATCHTOWER_NOTIFICATION_URL="${WATCHTOWER_NOTIFICATION_URL:-}"

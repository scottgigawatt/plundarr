#
# .env file: Environment variables for a generated Plundarr configuration.
#

#
# Name of the project which adds a namespace for all services and networks.
#
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-duplex}"

#
# Docker network settings for the project.
#
COMPOSE_NETWORK_SUBNET="${COMPOSE_NETWORK_SUBNET:-172.25.0.0/16}"
COMPOSE_NETWORK_IP_RANGE="${COMPOSE_NETWORK_IP_RANGE:-172.25.5.0/24}"
COMPOSE_NETWORK_GATEWAY="${COMPOSE_NETWORK_GATEWAY:-172.25.5.254}"

#
# Host paths to downloads and media folders.
#
HOST_DOWNLOADS_PATH="${HOST_DOWNLOADS_PATH:-/volume1/downloads}"                             # Edit for your host: shared download root
HOST_TORRENTS_DOWNLOADS_PATH="${HOST_TORRENTS_DOWNLOADS_PATH:-/volume1/downloads/torrents}"  # Edit for your host: torrent downloads
HOST_USENET_DOWNLOADS_PATH="${HOST_USENET_DOWNLOADS_PATH:-/volume1/downloads/usenet}"        # Edit for your host: Usenet downloads
HOST_MOVIES_PATH="${HOST_MOVIES_PATH:-/volume1/plex/movies}"                                 # Edit for your host: movie library
HOST_TV_PATH="${HOST_TV_PATH:-/volume1/plex/tv}"                                             # Edit for your host: television library
HOST_ANIME_TV_PATH="${HOST_ANIME_TV_PATH:-/volume1/plex/anime-tv}"                           # Edit for your host: anime library
HOST_SCENES_PATH="${HOST_SCENES_PATH:-/volume1/plex/scenes}"                                 # Edit for your host: Boudoirr scenes library

#
# Default container settings.
#
DEFAULT_PUID="${DEFAULT_PUID:-1000}"  # Edit for your host: run `id -u`
DEFAULT_PGID="${DEFAULT_PGID:-1000}"  # Edit for your host: run `id -g`
DEFAULT_GROUP="${DEFAULT_GROUP:-109}"
DEFAULT_UMASK="${DEFAULT_UMASK:-022}"

#
# Standard healthcheck timing settings.
#
DEFAULT_HEALTHCHECK_INTERVAL="${DEFAULT_HEALTHCHECK_INTERVAL:-10s}"
DEFAULT_HEALTHCHECK_TIMEOUT="${DEFAULT_HEALTHCHECK_TIMEOUT:-10s}"
DEFAULT_HEALTHCHECK_START_PERIOD="${DEFAULT_HEALTHCHECK_START_PERIOD:-10s}"
DEFAULT_HEALTHCHECK_RETRIES="${DEFAULT_HEALTHCHECK_RETRIES:-5}"

#
# Container logging settings.
#
LOG_MAX_SIZE="${LOG_MAX_SIZE:-50M}"
LOG_MAX_FILE="${LOG_MAX_FILE:-3}"

#
# Timezone for containers.
#
TZ="${TZ:-America/New_York}"  # Edit for your host: IANA timezone, for example America/New_York

#
# Kometa environment variables
#
KOMETA_TAG="${KOMETA_TAG:-latest}"
KOMETA_CONFIG_PATH="${KOMETA_CONFIG_PATH:-/volume1/docker/kometa-config}"  # Edit for your host: external Kometa config checkout
KOMETA_RUNTIME_CONFIG_PATH="${KOMETA_RUNTIME_CONFIG_PATH:-${KOMETA_CONFIG_PATH}/config.yml}"
KOMETA_DEBUG="${KOMETA_DEBUG:-false}"
KOMETA_TIMES="${KOMETA_TIMES:-05:00,17:00}"

#
# ImageMaid environment variables
#
IMAGE_MAID_TAG="${IMAGE_MAID_TAG:-latest}"
IMAGEMAID_CONFIG_PATH="${IMAGEMAID_CONFIG_PATH:-./config/imagemaid}"
IMAGEMAID_PLEX_PATH="${IMAGEMAID_PLEX_PATH:-/volume1/PlexMediaServer/AppData/Plex Media Server}"  # Edit for your host: Plex application-data directory

#
# Themerr environment variables
#
THEMERR_TAG="${THEMERR_TAG:-latest}"
THEMERR_WEBUI_PORT="${THEMERR_WEBUI_PORT:-9494}"                                         # Change only for a host-port conflict
THEMERR_CONNECTOR_PORT="${THEMERR_CONNECTOR_PORT:-9495}"                                 # Change only for a host-port conflict
THEMERR_CONFIG_PATH="${THEMERR_CONFIG_PATH:-./config/themerr}"                           # Edit for your host: existing writable Themerr state
THEMERR_TOKEN_KEY_PATH="${THEMERR_TOKEN_KEY_PATH:-./config/secrets/themerr-tokens.key}"  # Edit for your host: existing private encryption key

#
# PATTRMM environment variables
#
PATTRMM_TAG="${PATTRMM_TAG:-neo}"
PATTRMM_TIMES="${PATTRMM_TIMES:-02:00,14:00}"
PATTRMM_SETTINGS="${PATTRMM_SETTINGS:-settings.yml}"
PATTRMM_CONFIG_PATH="${PATTRMM_CONFIG_PATH:-./config/pattrmm}"
PATTRMM_SETTINGS_PATH="${PATTRMM_SETTINGS_PATH:-${KOMETA_CONFIG_PATH}/pattrmm}"

#
# Notifiarr environment variables
#
NOTIFIARR_TAG="${NOTIFIARR_TAG:-latest}"
NOTIFIARR_WEBUI_PORT="${NOTIFIARR_WEBUI_PORT:-5454}"  # Change only for a host-port conflict
NOTIFIARR_CONFIG_PATH="${NOTIFIARR_CONFIG_PATH:-./config/notifiarr}"

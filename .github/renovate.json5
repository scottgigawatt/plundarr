{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":enablePreCommit",
    ],
    ignorePaths: [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/__tests__/**",
        "**/tests/**",
        "**/__fixtures__/**",
    ],
    timezone: "America/New_York",
    schedule: ["* 0-7 1 * *"],
    automergeSchedule: ["* 0-7 1 * *"],
    updateNotScheduled: false,
    prConcurrentLimit: 2,
    dependencyDashboard: {
        enabled: true,
    },
    automerge: true,
    automergeType: "pr",
    automergeStrategy: "squash",
    platformAutomerge: false,
    rebaseWhen: "behind-base-branch",
    labels: ["dependencies"],
    assignees: ["scottgigawatt"],
    reviewers: ["scottgigawatt"],
    vulnerabilityAlerts: {
        enabled: true,
        dependencyDashboardApproval: false,
        groupName: null,
        automerge: false,
        schedule: ["at any time"],
        automergeSchedule: ["at any time"],
        updateNotScheduled: true,
    },
    enabledManagers: [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "github-actions",
        "npm",
        "pep621",
        "pip_requirements",
        "pre-commit",
    ],
    customManagers: [
        {
            customType: "regex",
            managerFilePatterns: ["/^Makefile$/"],
            matchStrings: [
                "DOCS_PYTHON_VERSION\\s+\\?=\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)",
            ],
            depNameTemplate: "python",
            datasourceTemplate: "python-version",
            versioningTemplate: "python",
        },
        {
            customType: "regex",
            managerFilePatterns: [
                "/^docker/Dockerfile$/",
                "/^test/typing/Dockerfile$/",
                "/^\\.github/workflows/build-and-push\\.yml$/",
            ],
            matchStrings: [
                "ALPINE_TAG[=:]\\s*(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
            ],
            depNameTemplate: "alpine",
            datasourceTemplate: "docker",
            versioningTemplate: "docker",
        },
        {
            customType: "regex",
            managerFilePatterns: ["/^example\\.maraudarr\\.env$/"],
            matchStrings: [
                'ALPINE_TAG="\\$\\{ALPINE_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}"',
            ],
            depNameTemplate: "alpine",
            datasourceTemplate: "docker",
            versioningTemplate: "docker",
        },
        {
            customType: "regex",
            managerFilePatterns: [
                "/^docker/Dockerfile$/",
                "/^\\.github/workflows/build-and-push\\.yml$/",
            ],
            matchStrings: [
                "DOCKER_COMPOSE_TAG[=:]\\s*(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
            ],
            depNameTemplate: "docker/compose-bin",
            datasourceTemplate: "docker",
            versioningTemplate: "docker",
        },
        {
            customType: "regex",
            managerFilePatterns: ["/^example\\.maraudarr\\.env$/"],
            matchStrings: [
                'DOCKER_COMPOSE_TAG="\\$\\{DOCKER_COMPOSE_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}"',
            ],
            depNameTemplate: "docker/compose-bin",
            datasourceTemplate: "docker",
            versioningTemplate: "docker",
        },
    ],
    packageRules: [
        {
            matchDatasources: ["docker"],
            pinDigests: true,
        },
        {
            groupName: "GitHub Actions",
            matchManagers: ["github-actions"],
        },
        {
            groupName: "pre-commit hooks",
            matchManagers: ["pre-commit"],
        },
        {
            groupName: "Docker images",
            matchDatasources: ["docker"],
        },
        {
            description: "Keep Python dependencies exact and hash-verified",
            matchManagers: ["pep621", "pip_requirements"],
            rangeStrategy: "pin",
        },
        {
            description: "Keep supported Python versions as a compatibility range",
            matchManagers: ["pep621"],
            matchDepTypes: ["requires-python"],
            rangeStrategy: "replace",
        },
        {
            groupName: "Python runtime",
            matchDepNames: ["python"],
        },
        {
            matchUpdateTypes: ["minor", "patch", "pin", "digest"],
            groupName: "monthly maintenance",
        },
        {
            matchDatasources: ["docker"],
            schedule: ["* 0-7 * * 1"],
            automergeSchedule: ["* 0-7 * * 1"],
            groupName: "weekly production dependencies",
        },
        {
            matchPackageNames: [
                "markdown-it-py",
                "mdurl",
                "prompt-toolkit",
                "Pygments",
                "questionary",
                "rich",
                "setuptools",
                "wcwidth",
            ],
            schedule: ["* 0-7 * * 1"],
            automergeSchedule: ["* 0-7 * * 1"],
            groupName: "weekly production dependencies",
        },
        {
            matchPackageNames: [
                "github.com/docker/compose/v5",
                "golang.org/x/net",
            ],
            schedule: ["* 0-7 * * 1"],
            automergeSchedule: ["* 0-7 * * 1"],
            groupName: "weekly production dependencies",
        },
        {
            matchUpdateTypes: ["major"],
            dependencyDashboardApproval: true,
            automerge: false,
            groupName: null,
        },
    ],
}
